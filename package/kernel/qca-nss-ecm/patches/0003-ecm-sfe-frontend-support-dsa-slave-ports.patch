+#if defined(CONFIG_NET_DSA)
+#include <net/dsa.h>
+
+/*
+ * ecm_sfe_common_adjust_dsa_ifaces_first()
+ *	Adjust interfaces_first to skip master net_device (e.g. eth0) when a DSA slave port
+ *	(e.g. port1..port3) is present as the next interface in the hierarchy.
+ *	In SFE, packets arrive from / are sent to the DSA slave port netdev directly.
+ */
+static inline int32_t ecm_sfe_common_adjust_dsa_ifaces_first(struct ecm_db_iface_instance *ifaces[], int32_t first)
+{
+	if (first + 1 < ECM_DB_IFACE_HEIRARCHY_MAX) {
+		int32_t slave_id = ecm_db_iface_interface_identifier_get(ifaces[first + 1]);
+		struct net_device *slave_dev = dev_get_by_index(&init_net, slave_id);
+		if (slave_dev) {
+			if (dsa_slave_dev_check(slave_dev)) {
+				dev_put(slave_dev);
+				ecm_db_iface_deref(ifaces[first]);
+				return first + 1;
+			}
+			dev_put(slave_dev);
+		}
+	}
+	return first;
+}
+
+/*
+ * ecm_sfe_common_is_dsa_slave_iface()
+ *	Check if the given interface instance corresponds to a DSA slave net_device.
+ */
+static inline bool ecm_sfe_common_is_dsa_slave_iface(struct ecm_db_iface_instance *ii)
+{
+	int32_t if_id = ecm_db_iface_interface_identifier_get(ii);
+	struct net_device *dev = dev_get_by_index(&init_net, if_id);
+	if (dev) {
+		bool is_dsa = dsa_slave_dev_check(dev);
+		dev_put(dev);
+		return is_dsa;
+	}
+	return false;
+}
+#endif

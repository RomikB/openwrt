+#include <linux/if_vlan.h>
+
+/*
+ * Safe wrapper for vlan_dev_get_egress_qos_mask to support DSA slave devices
+ * treated as VLAN interfaces in ECM without accessing unmapped struct vlan_dev_priv.
+ */
+static inline u16 ecm_vlan_dev_get_egress_qos_mask(struct net_device *dev, u32 qos_tag)
+{
+#ifdef CONFIG_VLAN_8021Q
+	if (is_vlan_dev(dev)) {
+		return vlan_dev_get_egress_qos_mask(dev, qos_tag);
+	}
+#endif
+	return 0;
+}
+#define vlan_dev_get_egress_qos_mask(dev, qos) ecm_vlan_dev_get_egress_qos_mask(dev, qos)
+

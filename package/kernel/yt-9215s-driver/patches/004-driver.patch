+};
+static const int portmap_ids[] = {
+	0, 1, 2, 3, 4, 10, 20
+};
+
+static int portmap_proc_init(void)
+{
+	int i;
+	struct proc_dir_entry *entry;
+
+	g_portmap_dir = proc_mkdir("portmap", NULL);
+	if (!g_portmap_dir) {
+		pr_err("[yt_switch] Create portmap directory failed.\n");
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(portmap_names); i++) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+		entry = proc_create_data(portmap_names[i], 0644, g_portmap_dir,
+					 &portmap_proc_ops, (void *)(uintptr_t)portmap_ids[i]);
+#else
+		entry = proc_create_data(portmap_names[i], 0644, g_portmap_dir,
+					 &portmap_fops, (void *)(uintptr_t)portmap_ids[i]);
+#endif
+		if (!entry) {
+			pr_err("[yt_switch] Create proc entry %s failed.\n", portmap_names[i]);
+			return -ENOMEM;
+		}
+	}
+
+	return 0;
+}
+
+static void portmap_proc_deinit(void)
+{
+	int i;
+
+	if (g_portmap_dir) {
+		for (i = 0; i < ARRAY_SIZE(portmap_names); i++)
+			remove_proc_entry(portmap_names[i], g_portmap_dir);
+
+		remove_proc_entry("portmap", NULL);
+		g_portmap_dir = NULL;
+	}
+}

+/* Find MDIO Bus on Qualcomm SoC */
+static int miwifi_smi_bus_init(void)
+{
+	struct device_node *np;
+
+	np = of_find_node_opts_by_path("/soc/mdio@90000", NULL);
+	if (!np) {
+		pr_err("[yt_switch] mdio-bus /soc/mdio@90000 not find\n");
+		return -ENODEV;
+	}
+
+	g_mii_bus = of_mdio_find_bus(np);
+	of_node_put(np);
+	if (!g_mii_bus) {
+		pr_err("[yt_switch] mdio-bus init failed\n");
+		return -ENODEV;
+	}
+
+	pr_info("[yt_switch] mdio-bus init success\n");
+	return 0;
+}

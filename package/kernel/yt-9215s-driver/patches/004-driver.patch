+/* Qualcomm PPE/ECM acceleration hook callback */
+static int yt_portmap_get_by_vid(u32 vid, u32 *portmap)
+{
+	if (!portmap)
+		return -EINVAL;
+
+	switch (vid) {
+	case 1:
+		*portmap = (1 << 3) | (1 << 5);
+		break;
+	case 2:
+		*portmap = (1 << 2) | (1 << 5);
+		break;
+	case 3:
+		*portmap = (1 << 1) | (1 << 5);
+		break;
+	case 4:
+		*portmap = (1 << 4) | (1 << 5);
+		break;
+	default:
+		*portmap = (1 << 5);
+		break;
+	}
+	return 0;
+}

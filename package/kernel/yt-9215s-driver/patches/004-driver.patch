+/* Procfs /proc/portmap Interface and Link Carrier Tracker */
+static inline int port_to_lan_idx(int port)
+{
+	switch (port) {
+	case 3: return 1;
+	case 2: return 2;
+	case 1: return 3;
+	default: return port;
+	}
+}
+
+static void yt_link_poll_worker(struct work_struct *work)
+{
+	int port;
+
+	for (port = 1; port <= 4; port++) {
+		yt_port_linkStatus_all_t status;
+		int err;
+		bool is_up;
+
+		memset(&status, 0, sizeof(status));
+		err = yt_port_link_status_all_get(0, port, &status);
+		if (err)
+			continue;
+
+		is_up = (status.link_status == PORT_LINK_UP);
+
+		if (is_up != g_portmap[port].link_up) {
+			g_portmap[port].link_up = is_up;
+			if (is_up) {
+				const char *spd_str = "1000Mb";
+				if (status.link_speed == PORT_SPEED_100M)
+					spd_str = "100Mb";
+				else if (status.link_speed == PORT_SPEED_10M)
+					spd_str = "10Mb";
+				else if (status.link_speed == PORT_SPEED_2500M)
+					spd_str = "2500Mb";
+
+				pr_info("[yt_switch] Lan%d: Phy%d Link Up - %s/%s\n",
+					port_to_lan_idx(port), port, spd_str,
+					status.link_duplex == PORT_DUPLEX_FULL ? "Duplex" : "Half");
+			} else {
+				pr_info("[yt_switch] Lan%d: Phy%d Link Down\n",
+					port_to_lan_idx(port), port);
+			}
+		}
+
+		if (g_portmap[port].ifname[0]) {
+			struct net_device *dev = dev_get_by_name(&init_net, g_portmap[port].ifname);
+			if (dev) {
+				if (is_up && !netif_carrier_ok(dev)) {
+					pr_info("[yt_switch] portmap_proc_set_interface_cmd[74]:carrier on %s\n",
+						g_portmap[port].ifname);
+					netif_carrier_on(dev);
+				} else if (!is_up && netif_carrier_ok(dev)) {
+					pr_info("[yt_switch] portmap_proc_set_interface_cmd[87]:carrier off %s\n",
+						g_portmap[port].ifname);
+					netif_carrier_off(dev);
+				}
+				dev_put(dev);
+			}
+		}
+	}
+
+	queue_delayed_work(g_yt_wq, &g_link_poll_work, msecs_to_jiffies(1000));
+}
+
+static int portmap_proc_show(struct seq_file *m, void *v)
+{
+	int port = (int)(uintptr_t)m->private;
+
+	if (port >= 0 && port < 7) {
+		if (g_portmap[port].ifname[0])
+			seq_printf(m, "%s\n", g_portmap[port].ifname);
+		else
+			seq_puts(m, "\n");
+	}
+	return 0;
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 17, 0)
+#define yt_pde_data(inode) pde_data(inode)
+#else
+#define yt_pde_data(inode) PDE_DATA(inode)
+#endif
+
+static int portmap_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, portmap_proc_show, yt_pde_data(inode));
+}
+
+static ssize_t portmap_proc_write(struct file *file, const char __user *user_buf,
+				  size_t count, loff_t *ppos)
+{
+	int port = (int)(uintptr_t)yt_pde_data(file_inode(file));
+	char buf[32];
+	char ifname[IFNAMSIZ];
+	size_t len;
+	struct net_device *dev;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+
+	buf[count] = '\0';
+	len = strlen(buf);
+	while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r' || buf[len - 1] == ' '))
+		buf[--len] = '\0';
+
+	if (len >= IFNAMSIZ)
+		return -EINVAL;
+
+	strncpy(ifname, buf, IFNAMSIZ - 1);
+	ifname[IFNAMSIZ - 1] = '\0';
+
+	if (port == 10) {
+		dev = dev_get_by_name(&init_net, ifname);
+		if (dev) {
+			pr_info("[yt_switch] portmap_proc_set_interface_cmd[74]:carrier on %s\n", ifname);
+			netif_carrier_on(dev);
+			dev_put(dev);
+		}
+		return count;
+	}
+
+	if (port == 20) {
+		dev = dev_get_by_name(&init_net, ifname);
+		if (dev) {
+			pr_info("[yt_switch] portmap_proc_set_interface_cmd[87]:carrier off %s\n", ifname);
+			netif_carrier_off(dev);
+			dev_put(dev);
+		}
+		return count;
+	}
+
+	if (port >= 0 && port < 7) {
+		if (len == 0) {
+			pr_info("[yt_switch] portmap: clean port %d ifname\n", port);
+			g_portmap[port].ifname[0] = '\0';
+		} else {
+			pr_info("[yt_switch] portmap: set port %d ifname %s\n", port, ifname);
+			strncpy(g_portmap[port].ifname, ifname, sizeof(g_portmap[port].ifname) - 1);
+			g_portmap[port].ifname[sizeof(g_portmap[port].ifname) - 1] = '\0';
+
+			dev = dev_get_by_name(&init_net, ifname);
+			if (dev) {
+				pr_info("[yt_switch] portmap_proc_set_interface_cmd[87]:carrier off %s\n", ifname);
+				netif_carrier_off(dev);
+				dev_put(dev);
+			}
+		}
+	}
+
+	return count;
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+static const struct proc_ops portmap_proc_ops = {
+	.proc_open    = portmap_proc_open,
+	.proc_read    = seq_read,
+	.proc_lseek   = seq_lseek,
+	.proc_release = single_release,
+	.proc_write   = portmap_proc_write,
+};
+#else
+static const struct file_operations portmap_fops = {
+	.owner   = THIS_MODULE,
+	.open    = portmap_proc_open,
+	.read    = seq_read,
+	.llseek  = seq_lseek,
+	.release = single_release,
+	.write   = portmap_proc_write,
+};
+#endif

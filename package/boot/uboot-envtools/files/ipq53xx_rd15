[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
xiaomi,be3600|\
xiaomi,rd15|\
qcom,ipq5332-ap-mi04.1*|\
*)
	ubootenv_add_uci_config "/dev/mtd13" "0x0" "0x10000" "0x20000"
	ubootenv_add_uci_sys_config "/dev/mtd21" "0x0" "0x10000" "0x20000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0

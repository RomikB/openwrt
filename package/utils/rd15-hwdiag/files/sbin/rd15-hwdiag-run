#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Xiaomi Router BE3600 (RD15) Hardware Diagnostic & Auto-Rollback Utility
# Collects full system diagnostics directly to /data then reverts U-Boot rootfs slot.

# Never fail on errors
set +e

ENABLED=$(uci -q get rd15-hwdiag.settings.enabled 2>/dev/null || echo "1")
[ "$ENABLED" = "1" ] || exit 0

# 1. Determine rollback target slot immediately
target_slot=0
cmdline=$(cat /proc/cmdline 2>/dev/null || true)
if echo "$cmdline" | grep -q "rootfs_1"; then
	target_slot=0
elif echo "$cmdline" | grep -q "rootfs"; then
	target_slot=1
else
	cur_nvram=$(nvram get flag_boot_rootfs 2>/dev/null || echo "1")
	if [ "$cur_nvram" = "1" ]; then
		target_slot=0
	else
		target_slot=1
	fi
fi

# Helper function to run commands with strict timeout protection
run_timeout() {
	local sec="$1"
	shift
	if command -v timeout >/dev/null 2>&1; then
		timeout -t "$sec" "$@" 2>/dev/null || timeout "$sec" "$@" 2>/dev/null || true
	else
		( "$@" ) 2>/dev/null &
		local sub_pid=$!
		( sleep "$sec"; kill -9 "$sub_pid" 2>/dev/null ) &
		local timer_pid=$!
		wait "$sub_pid" 2>/dev/null || true
		kill -9 "$timer_pid" 2>/dev/null || true
	fi
}

# 2. Autonomous safety watchdog timer (60s countdown)
# Guarantees rollback and reboot even if any driver or subsystem hangs in uninterruptible sleep (D-state).
(
	sleep 60
	echo "WATCHDOG TIMEOUT: forcing emergency dual-boot rollback to slot $target_slot" > /data/WATCHDOG_TRIGGERED.txt 2>/dev/null || true
	if command -v nvram >/dev/null 2>&1; then
		nvram set flag_boot_rootfs="$target_slot" 2>/dev/null || true
		nvram set flag_last_success="$target_slot" 2>/dev/null || true
		nvram set flag_boot_success="1" 2>/dev/null || true
		nvram set flag_try_sys1_failed="0" 2>/dev/null || true
		nvram set flag_try_sys2_failed="0" 2>/dev/null || true
		nvram commit 2>/dev/null || true
	fi
	sync
	echo 1 > /proc/sys/kernel/sysrq 2>/dev/null || true
	echo b > /proc/sysrq-trigger 2>/dev/null || true
	reboot -f 2>/dev/null || true
) &
WATCHDOG_PID=$!

# 3. Visual LED indication: Start alternating orange/blue blinker immediately
touch /tmp/rd15_hwdiag_running
(
	while [ -f /tmp/rd15_hwdiag_running ]; do
		echo none > /sys/class/leds/blue:status/trigger 2>/dev/null || true
		echo none > /sys/class/leds/orange:status/trigger 2>/dev/null || true
		echo 255 > /sys/class/leds/orange:status/brightness 2>/dev/null || true
		echo 0 > /sys/class/leds/blue:status/brightness 2>/dev/null || true
		usleep 200000 2>/dev/null || sleep 1
		[ -f /tmp/rd15_hwdiag_running ] || break
		echo 0 > /sys/class/leds/orange:status/brightness 2>/dev/null || true
		echo 255 > /sys/class/leds/blue:status/brightness 2>/dev/null || true
		usleep 200000 2>/dev/null || sleep 1
	done
) &
BLINK_PID=$!

# 4. Ensure /data partition is mounted (mounted in preinit, fallback protected by timeout)
if ! grep -q "/data" /proc/mounts; then
	mkdir -p /data 2>/dev/null || true
	run_timeout 3 mount -t ubifs ubi1:cfg /data 2>/dev/null || \
	run_timeout 3 mount -t ubifs ubi1:data /data 2>/dev/null || true
fi

DIAG_DIR="/data/hwdiag"
if [ ! -w /data ]; then
	DIAG_DIR="/tmp/hwdiag"
fi
mkdir -p "$DIAG_DIR" 2>/dev/null || true

# ==============================================================================
# PHASE 1: Safe Core & Kernel Logs (Directly into /data, flushed immediately)
# ==============================================================================
dmesg > "$DIAG_DIR/dmesg.log" 2>/dev/null || true
cp "$DIAG_DIR/dmesg.log" "/data/hwdiag_dmesg.log" 2>/dev/null || true
logread > "$DIAG_DIR/logread.log" 2>/dev/null || true
uname -a > "$DIAG_DIR/uname.txt" 2>/dev/null || true
cat /proc/version > "$DIAG_DIR/proc_version.txt" 2>/dev/null || true
cat /proc/cmdline > "$DIAG_DIR/proc_cmdline.txt" 2>/dev/null || true
cat /proc/cpuinfo > "$DIAG_DIR/proc_cpuinfo.txt" 2>/dev/null || true
cat /proc/meminfo > "$DIAG_DIR/proc_meminfo.txt" 2>/dev/null || true
cat /proc/interrupts > "$DIAG_DIR/proc_interrupts.txt" 2>/dev/null || true
lsmod > "$DIAG_DIR/lsmod.txt" 2>/dev/null || true
cat /proc/modules > "$DIAG_DIR/proc_modules.txt" 2>/dev/null || true
sync

# ==============================================================================
# PHASE 2: Xiaomi Platform, NVRAM, BDATA & Device Tree
# ==============================================================================
if [ -d /proc/xiaoqiang ]; then
	mkdir -p "$DIAG_DIR/xiaoqiang" 2>/dev/null || true
	for f in /proc/xiaoqiang/*; do
		[ -f "$f" ] && cat "$f" > "$DIAG_DIR/xiaoqiang/$(basename "$f")" 2>/dev/null || true
	done
fi

if command -v nvram >/dev/null 2>&1; then
	nvram show > "$DIAG_DIR/nvram_show.txt" 2>/dev/null || true
fi

if command -v bdata >/dev/null 2>&1; then
	bdata show > "$DIAG_DIR/bdata_show.txt" 2>/dev/null || true
fi

if [ -f /sys/firmware/fdt ]; then
	cp /sys/firmware/fdt "$DIAG_DIR/live_fdt.dtb" 2>/dev/null || true
fi
if [ -d /proc/device-tree ]; then
	[ -f /proc/device-tree/model ] && tr '\0' '\n' < /proc/device-tree/model > "$DIAG_DIR/dt_model.txt" 2>/dev/null || true
	[ -f /proc/device-tree/compatible ] && tr '\0' '\n' < /proc/device-tree/compatible > "$DIAG_DIR/dt_compatible.txt" 2>/dev/null || true
fi
sync

# ==============================================================================
# PHASE 3: Storage, Partitions, ART Caldata Header & Raw BDATA
# ==============================================================================
cat /proc/mtd > "$DIAG_DIR/proc_mtd.txt" 2>/dev/null || true
cat /proc/partitions > "$DIAG_DIR/proc_partitions.txt" 2>/dev/null || true
cat /proc/mounts > "$DIAG_DIR/proc_mounts.txt" 2>/dev/null || true
df -h > "$DIAG_DIR/df.txt" 2>/dev/null || true

if command -v ubinfo >/dev/null 2>&1; then
	ubinfo -a > "$DIAG_DIR/ubinfo.txt" 2>/dev/null || true
fi

art_dev=""
if [ -f /lib/functions.sh ]; then
	. /lib/functions.sh
	art_dev=$(find_mtd_part "0:ART" 2>/dev/null || true)
	[ -z "$art_dev" ] && art_dev=$(find_mmc_part "0:ART" 2>/dev/null || true)
fi
if [ -n "$art_dev" ] && [ -e "$art_dev" ]; then
	dd if="$art_dev" of="$DIAG_DIR/art_caldata_header_128k.bin" bs=64k count=2 2>/dev/null || true
fi

bdata_dev=""
if [ -f /lib/functions.sh ]; then
	bdata_dev=$(find_mtd_part "0:bdata" 2>/dev/null || true)
	[ -z "$bdata_dev" ] && bdata_dev=$(find_mtd_part "bdata" 2>/dev/null || true)
	[ -z "$bdata_dev" ] && bdata_dev=$(find_mmc_part "0:bdata" 2>/dev/null || true)
fi
if [ -n "$bdata_dev" ] && [ -e "$bdata_dev" ]; then
	dd if="$bdata_dev" of="$DIAG_DIR/bdata_raw_64k.bin" bs=64k count=1 2>/dev/null || true
fi
sync

# ==============================================================================
# PHASE 4: Hardware Buses (PCIe and MDIO - Passive Sysfs Queries)
# ==============================================================================
if command -v lspci >/dev/null 2>&1; then
	lspci -vvv > "$DIAG_DIR/lspci_vvv.txt" 2>/dev/null || true
	lspci -tv > "$DIAG_DIR/lspci_tree.txt" 2>/dev/null || true
fi
if [ -d /sys/bus/pci/devices ]; then
	ls -la /sys/bus/pci/devices/ > "$DIAG_DIR/pci_devices_ls.txt" 2>/dev/null || true
	for pdev in /sys/bus/pci/devices/*; do
		if [ -d "$pdev" ]; then
			pname=$(basename "$pdev")
			mkdir -p "$DIAG_DIR/pci_sysfs/$pname" 2>/dev/null || true
			for attr in vendor device subsystem_vendor subsystem_device class uevent; do
				[ -f "$pdev/$attr" ] && cat "$pdev/$attr" > "$DIAG_DIR/pci_sysfs/$pname/$attr" 2>/dev/null || true
			done
		fi
	done
fi

if [ -d /sys/bus/mdio_bus/devices ]; then
	ls -la /sys/bus/mdio_bus/devices/ > "$DIAG_DIR/mdio_devices_list.txt" 2>/dev/null || true
	for mdev in /sys/bus/mdio_bus/devices/*; do
		if [ -d "$mdev" ]; then
			mdname=$(basename "$mdev")
			mkdir -p "$DIAG_DIR/mdio_sysfs/$mdname" 2>/dev/null || true
			[ -f "$mdev/phy_id" ] && cat "$mdev/phy_id" > "$DIAG_DIR/mdio_sysfs/$mdname/phy_id" 2>/dev/null || true
			[ -f "$mdev/uevent" ] && cat "$mdev/uevent" > "$DIAG_DIR/mdio_sysfs/$mdname/uevent" 2>/dev/null || true
		fi
	done
fi
sync

# ==============================================================================
# PHASE 5: Passive Network Sysfs & Interface Status
# ==============================================================================
if command -v ip >/dev/null 2>&1; then
	ip addr show > "$DIAG_DIR/ip_addr.txt" 2>/dev/null || true
	ip -s link show > "$DIAG_DIR/ip_link.txt" 2>/dev/null || true
	ip route show > "$DIAG_DIR/ip_route.txt" 2>/dev/null || true
fi
ifconfig -a > "$DIAG_DIR/ifconfig_a.txt" 2>/dev/null || true
cat /proc/net/dev > "$DIAG_DIR/proc_net_dev.txt" 2>/dev/null || true
cat /proc/net/arp > "$DIAG_DIR/proc_net_arp.txt" 2>/dev/null || true

if command -v brctl >/dev/null 2>&1; then
	brctl show > "$DIAG_DIR/brctl_show.txt" 2>/dev/null || true
fi

mkdir -p "$DIAG_DIR/sys_net" 2>/dev/null || true
for ifp in /sys/class/net/*; do
	if [ -d "$ifp" ]; then
		ifname=$(basename "$ifp")
		mkdir -p "$DIAG_DIR/sys_net/$ifname" 2>/dev/null || true
		for a in address carrier duplex speed operstate mtu flags; do
			[ -f "$ifp/$a" ] && cat "$ifp/$a" > "$DIAG_DIR/sys_net/$ifname/$a" 2>/dev/null || true
		done
	fi
done

ls -la /lib/firmware/ > "$DIAG_DIR/lib_firmware_ls.txt" 2>/dev/null || true
[ -d /lib/firmware/IPQ5332 ] && ls -la /lib/firmware/IPQ5332/ > "$DIAG_DIR/firmware_ipq5332_ls.txt" 2>/dev/null || true
[ -d /lib/firmware/QCN6432 ] && ls -la /lib/firmware/QCN6432/ > "$DIAG_DIR/firmware_qcn6432_ls.txt" 2>/dev/null || true
sync

# ==============================================================================
# PHASE 6: Generate Base Summary (Flushed to disk immediately)
# ==============================================================================
cat << EOF > "$DIAG_DIR/SUMMARY.txt"
=====================================================
Xiaomi RD15 Hardware Diagnostics Summary
=====================================================
Date: $(date 2>/dev/null || echo "N/A")
Kernel: $(cat /proc/version 2>/dev/null)
Cmdline: $(cat /proc/cmdline 2>/dev/null)
XiaoQiang Model: $(cat /proc/xiaoqiang/model 2>/dev/null || echo "N/A")
XiaoQiang Boot Status: $(cat /proc/xiaoqiang/boot_status 2>/dev/null || echo "N/A")

Network Interfaces:
$(ls /sys/class/net 2>/dev/null | tr '\n' ' ')

PCI Devices:
$(ls /sys/bus/pci/devices 2>/dev/null | tr '\n' ' ')

MDIO Devices:
$(ls /sys/bus/mdio_bus/devices 2>/dev/null | tr '\n' ' ')
=====================================================
EOF
cp "$DIAG_DIR/SUMMARY.txt" "/data/rd15_hwdiag_summary.txt" 2>/dev/null || true
sync

# ==============================================================================
# PHASE 7: Active Diagnostics with Strict Timeout Protection (Riskier calls)
# ==============================================================================
# Allow 10s for concurrent system background drivers to settle
sleep 10

# Ethtool (2s timeout per call)
if command -v ethtool >/dev/null 2>&1; then
	for eth in eth0 eth1 eth2 eth3; do
		if [ -d "/sys/class/net/$eth" ]; then
			run_timeout 2 ethtool "$eth" > "$DIAG_DIR/ethtool_${eth}.txt"
			run_timeout 2 ethtool -S "$eth" > "$DIAG_DIR/ethtool_stats_${eth}.txt"
		fi
	done
fi

# Switch registers (2s timeout)
[ -f /proc/smi ] && run_timeout 2 cat /proc/smi > "$DIAG_DIR/proc_smi.txt"
[ -f /proc/mib ] && run_timeout 2 cat /proc/mib > "$DIAG_DIR/proc_mib.txt"
[ -f /proc/switch ] && run_timeout 2 cat /proc/switch > "$DIAG_DIR/proc_switch.txt"

# Wireless Diagnostics (2s timeout)
if command -v iw >/dev/null 2>&1; then
	run_timeout 2 iw dev > "$DIAG_DIR/iw_dev.txt"
	run_timeout 2 iw phy > "$DIAG_DIR/iw_phy.txt"
fi
if command -v iwconfig >/dev/null 2>&1; then
	run_timeout 2 iwconfig > "$DIAG_DIR/iwconfig.txt"
fi
if command -v wifi >/dev/null 2>&1; then
	run_timeout 2 wifi status > "$DIAG_DIR/wifi_status.txt"
fi
if command -v ubus >/dev/null 2>&1; then
	run_timeout 2 ubus call network.wireless status > "$DIAG_DIR/ubus_wireless.json"
	run_timeout 2 ubus call network.interface dump > "$DIAG_DIR/ubus_network.json"
fi
if command -v cfg80211tool >/dev/null 2>&1; then
	run_timeout 2 cfg80211tool wifi0 getCountry > "$DIAG_DIR/cfg80211_wifi0_country.txt"
	run_timeout 2 cfg80211tool wifi1 getCountry > "$DIAG_DIR/cfg80211_wifi1_country.txt"
fi

# Debugfs GPIO (2s timeout)
if [ ! -f /sys/kernel/debug/gpio ]; then
	mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
fi
if [ -f /sys/kernel/debug/gpio ]; then
	run_timeout 2 cat /sys/kernel/debug/gpio > "$DIAG_DIR/gpio_dump.txt"
fi

# Update summary and sync
cp "$DIAG_DIR/SUMMARY.txt" "/data/rd15_hwdiag_summary.txt" 2>/dev/null || true
sync

# ==============================================================================
# PHASE 8: Package Archive, Commit U-Boot Rollback, and Reboot
# ==============================================================================
ARCHIVE_TAR="/data/rd15_diag_latest.tar.gz"
tar -czf "$ARCHIVE_TAR" -C "$DIAG_DIR" . 2>/dev/null || true
TIMESTAMP=$(date +%Y%m%d_%H%M%S 2>/dev/null || echo "boot")
cp "$ARCHIVE_TAR" "$DIAG_DIR/rd15_diag_${TIMESTAMP}.tar.gz" 2>/dev/null || true
sync

# Dual-Boot Rollback: Switch to target slot
if command -v nvram >/dev/null 2>&1; then
	nvram set flag_boot_rootfs="$target_slot" 2>/dev/null || true
	nvram set flag_last_success="$target_slot" 2>/dev/null || true
	nvram set flag_boot_success="1" 2>/dev/null || true
	nvram set flag_try_sys1_failed="0" 2>/dev/null || true
	nvram set flag_try_sys2_failed="0" 2>/dev/null || true
	nvram commit 2>/dev/null || true
fi

# Stop background blinker and watchdog timer
rm -f /tmp/rd15_hwdiag_running
[ -n "$BLINK_PID" ] && kill "$BLINK_PID" 2>/dev/null || true
[ -n "$WATCHDOG_PID" ] && kill "$WATCHDOG_PID" 2>/dev/null || true

# Final LED status: Solid orange before reboot
if [ -d /sys/class/leds/blue:status ]; then
	echo none > /sys/class/leds/blue:status/trigger 2>/dev/null || true
	echo 0 > /sys/class/leds/blue:status/brightness 2>/dev/null || true
fi
if [ -d /sys/class/leds/orange:status ]; then
	echo none > /sys/class/leds/orange:status/trigger 2>/dev/null || true
	echo 255 > /sys/class/leds/orange:status/brightness 2>/dev/null || true
fi

sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
sleep 2
reboot -f

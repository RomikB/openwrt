+int ubi_remove_dev_force(libubi_t desc, const char *node, int ubi_dev)
+{
+	int fd, ret;
+	(void)desc;
+
+	fd = open(node, O_RDONLY);
+	if (fd == -1)
+		return sys_errmsg("cannot open \"%s\"", node);
+	ret = ioctl(fd, UBI_IOCFDET, &ubi_dev);
+	if (ret == -1)
+		goto out_close;

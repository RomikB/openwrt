#
# Stock Qualcomm QSDK Wireless Configuration Template for Xiaomi RD15
# Used by /sbin/wifi-stock-test to test authentic vendor driver bringup
#

config wifi-device 'wifi0'
	option type 'qcawificfg80211'
	option phy 'wifi0'
	option channel '3'
	option hwmode '11beg'
	option htmode 'HT40'
	option country 'CN'
	option disabled '0'
	option txpwr 'max'
	option txbf '3'
	option ax '1'
	option bw '40'
	option CSwOpts '0x31'
	option force_hostapd_attach '1'

config wifi-iface 'default_wifi0'
	option device 'wifi0'
	option ifname 'wl1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Xiaomi_RD15_2.4G_Stock'
	option encryption 'psk2'
	option key '12345678'
	option disabled '0'

config wifi-device 'wifi1'
	option type 'qcawificfg80211'
	option phy 'wifi1'
	option channel '44'
	option hwmode '11bea'
	option htmode 'HT80'
	option country 'CN'
	option disabled '0'
	option txpwr 'max'
	option txbf '3'
	option ax '1'
	option bw '80'
	option CSwOpts '0x31'
	option force_hostapd_attach '1'

config wifi-iface 'default_wifi1'
	option device 'wifi1'
	option ifname 'wl0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Xiaomi_RD15_5G_Stock'
	option encryption 'psk2'
	option key '12345678'
	option disabled '0'

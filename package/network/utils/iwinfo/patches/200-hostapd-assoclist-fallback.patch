+static const char *get_hostapd_sock_name(const char *ifname)
+{
+	char path[128];
+	snprintf(path, sizeof(path), "/var/run/hostapd/%s", ifname);
+	if (access(path, F_OK) == 0)
+		return ifname;
+
+	if (strstr(ifname, "radio1") || strstr(ifname, "phy2") || strstr(ifname, "wifi1"))
+		return "ath1";
+	if (strstr(ifname, "radio0") || strstr(ifname, "phy1") || strstr(ifname, "wifi0"))
+		return "ath0";
+	return ifname;
+}
+
+
+static uint8_t calc_mcs(uint32_t rate_kbps, int mhz, int nss, int is_eht, int is_he)
+{
+	if (nss < 1) nss = 1;
+	if (mhz < 20) mhz = 20;
+
+	uint32_t r1 = rate_kbps / nss;
+	uint32_t r0 = (r1 * 160) / mhz;
+
+	if (is_eht) {
+		if (r0 >= 1350000) return 13;
+		if (r0 >= 1250000) return 12;
+	}
+	if (r0 >= 1140000) return 11;
+	if (r0 >= 1020000) return 10;
+	if (r0 >= 910000)  return 9;
+	if (r0 >= 790000)  return 8;
+	if (r0 >= 680000)  return 7;
+	if (r0 >= 560000)  return 6;
+	if (r0 >= 420000)  return 5;
+	if (r0 >= 300000)  return 4;
+	if (r0 >= 210000)  return 3;
+	if (r0 >= 150000)  return 2;
+	if (r0 >= 90000)   return 1;
+	return 0;
+}

+/*
+ * Compatibility helper: old libubox versions used by some OpenWrt trees
+ * do not provide mkdir_p() in <libubox/utils.h>.
+ */
+static int mkdir_p_compat(char *dir, mode_t mask)
+{
+	char *l;
+	int ret;
+
+	ret = mkdir(dir, mask);
+	if (!ret || errno == EEXIST)
+		return 0;
+
+	if (errno != ENOENT)
+		return -1;
+
+	l = strrchr(dir, '/');
+	if (!l || l == dir)
+		return -1;
+
+	*l = '\0';
+	if (mkdir_p_compat(dir, mask))
+		return -1;
+	*l = '/';
+
+	ret = mkdir(dir, mask);
+	if (!ret || errno == EEXIST)
+		return 0;
+
+	return -1;
+}

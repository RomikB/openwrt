#!/bin/sh
#
# OpenWrt 24 Wi-Fi Control Utility for Xiaomi Router BE3600 (RD15)
#

. /lib/functions.sh

WIFI_LOCK="/var/run/wifi.lock"

usage() {
	cat << EOF
Usage: $0 [config|up|down|reconf|reload|status|isup] [radio0|radio1]
Control wireless interfaces and hostapd services for Qualcomm Direct Connect.
EOF
	exit 1
}

lock_wifi() {
	exec 200>"$WIFI_LOCK"
	flock -x -w 5 200 2>/dev/null || true
}

unlock_wifi() {
	flock -u 200 2>/dev/null || true
}

wifi_config() {
	if [ ! -s /etc/config/wireless ]; then
		[ -f /rom/etc/config/wireless ] && cp -f /rom/etc/config/wireless /etc/config/wireless
	fi
}

wifi_up() {
	local dev="$1"
	lock_wifi

	wifi_config
	if [ -n "$dev" ]; then
		ubus call network.wireless up "{\"device\":\"$dev\"}" 2>/dev/null || true
	else
		ubus call network.wireless up 2>/dev/null || true
	fi

	unlock_wifi
}

wifi_down() {
	local dev="$1"
	lock_wifi

	if [ -n "$dev" ]; then
		ubus call network.wireless down "{\"device\":\"$dev\"}" 2>/dev/null || true
	else
		ubus call network.wireless down 2>/dev/null || true
	fi

	unlock_wifi
}

wifi_reload() {
	local dev="$1"
	lock_wifi

	wifi_config
	ubus call network reload 2>/dev/null || true
	if [ -n "$dev" ]; then
		ubus call network.wireless reconf "{\"device\":\"$dev\"}" 2>/dev/null || true
	fi

	unlock_wifi
}

wifi_isup() {
	local dev="$1"
	if [ "$dev" = "radio0" ] || [ -z "$dev" ]; then
		[ -d /sys/class/net/ath0 ] && return 0
	fi
	if [ "$dev" = "radio1" ] || [ -z "$dev" ]; then
		[ -d /sys/class/net/ath1 ] && return 0
	fi
	return 1
}

wifi_status() {
	echo "=== Wireless Subsystem Status ==="
	echo "Driver wifi_3_0: $([ -d /sys/module/wifi_3_0 ] && echo 'Loaded' || echo 'Not Loaded')"
	echo ""
	echo "--- VAP Interfaces ---"
	for iface in ath0 ath01 ath1 ath11; do
		if [ -d "/sys/class/net/$iface" ]; then
			local state=$(cat /sys/class/net/$iface/operstate 2>/dev/null || echo "unknown")
			local addr=$(cat /sys/class/net/$iface/address 2>/dev/null || echo "unknown")
			echo "Interface $iface: UP ($state), MAC: $addr"
			if command -v iw >/dev/null 2>&1; then
				iw dev "$iface" info 2>/dev/null | grep -E "type|channel|txpower|ssid"
			fi
			echo ""
		fi
	done

	echo "--- Running Hostapd Daemons ---"
	ps | grep hostapd | grep -v grep || echo "No hostapd process running"
	echo ""
	echo "--- Running WPA Supplicant Daemons ---"
	ps | grep wpa_supplicant | grep -v grep || echo "No wpa_supplicant process running"
}

case "$1" in
	down)
		wifi_down "$2"
		;;
	config|detect)
		wifi_config
		;;
	status)
		wifi_status "$2"
		;;
	isup)
		wifi_isup "$2"
		exit $?
		;;
	reload|reconf)
		wifi_reload "$2"
		;;
	''|up)
		wifi_up "$2"
		;;
	--help|help)
		usage
		;;
	*)
		wifi_reload "$1"
		;;
esac

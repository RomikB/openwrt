#!/bin/sh
#
# OpenWrt 24 Wi-Fi Control Utility for Xiaomi Router BE3600 (RD15)
#

. /lib/functions.sh

WIFI_LOCK="/var/run/wifi.lock"

usage() {
	cat << EOF
Usage: $0 [config|up|down|reconf|reload|status|isup] [radio0|radio1]
Control wireless interfaces and hostapd services for Qualcomm Direct Connect.
EOF
	exit 1
}

lock_wifi() {
	exec 200>"$WIFI_LOCK"
	flock -x -w 5 200 2>/dev/null || true
}

unlock_wifi() {
	flock -u 200 2>/dev/null || true
}

wifi_config() {
	if [ ! -s /etc/config/wireless ]; then
		echo "Creating default /etc/config/wireless..."
		cat << 'EOF' > /etc/config/wireless
config wifi-device 'radio0'
	option type 'mac80211'
	option channel '1'
	option band '2g'
	option htmode 'HE40'
	option hwmode '11ax'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt_RD15_2.4G'
	option encryption 'psk2'
	option key '12345678'
	option ifname 'ath0'

config wifi-device 'radio1'
	option type 'mac80211'
	option channel '36'
	option band '5g'
	option htmode 'HE160'
	option hwmode '11axa'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt_RD15_5G'
	option encryption 'psk2'
	option key '12345678'
	option ifname 'ath1'
EOF
	fi
}

wifi_up() {
	local dev="$1"
	lock_wifi

	if [ -n "$dev" ]; then
		uci set wireless."$dev".disabled='0' 2>/dev/null || true
		uci commit wireless 2>/dev/null || true
	fi

	/etc/init.d/qca-hostapd start
	unlock_wifi
}

wifi_down() {
	local dev="$1"
	lock_wifi

	if [ -n "$dev" ]; then
		uci set wireless."$dev".disabled='1' 2>/dev/null || true
		uci commit wireless 2>/dev/null || true
		local ifname="ath0"
		[ "$dev" = "radio1" ] && ifname="ath1"
		local pid=$(cat "/var/run/hostapd-${ifname}.pid" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null || true
		rm -f "/var/run/hostapd-${ifname}.pid" "/var/run/hostapd-${ifname}.conf.active"
	else
		/etc/init.d/qca-hostapd stop
	fi

	unlock_wifi
}

wifi_reload() {
	local dev="$1"
	lock_wifi

	/etc/init.d/qca-hostapd reload
	unlock_wifi
}

wifi_isup() {
	local dev="$1"
	if [ "$dev" = "radio0" ] || [ -z "$dev" ]; then
		[ -d /sys/class/net/ath0 ] && return 0
	fi
	if [ "$dev" = "radio1" ] || [ -z "$dev" ]; then
		[ -d /sys/class/net/ath1 ] && return 0
	fi
	return 1
}

wifi_status() {
	echo "=== Wireless Subsystem Status ==="
	echo "Driver wifi_3_0: $([ -d /sys/module/wifi_3_0 ] && echo 'Loaded' || echo 'Not Loaded')"
	echo ""
	echo "--- VAP Interfaces ---"
	for iface in ath0 ath1; do
		if [ -d "/sys/class/net/$iface" ]; then
			local state=$(cat /sys/class/net/$iface/operstate 2>/dev/null || echo "unknown")
			local addr=$(cat /sys/class/net/$iface/address 2>/dev/null || echo "unknown")
			echo "Interface $iface: UP ($state), MAC: $addr"
			if command -v iw >/dev/null 2>&1; then
				iw dev "$iface" info 2>/dev/null | grep -E "type|channel|txpower|ssid"
			fi
		else
			echo "Interface $iface: DOWN / Not Created"
		fi
		echo ""
	done

	echo "--- Running Hostapd Daemons ---"
	ps | grep hostapd | grep -v grep || echo "No hostapd process running"
}

case "$1" in
	down)
		wifi_down "$2"
		;;
	config|detect)
		wifi_config
		;;
	status)
		wifi_status "$2"
		;;
	isup)
		wifi_isup "$2"
		exit $?
		;;
	reload|reconf)
		wifi_reload "$2"
		;;
	''|up)
		wifi_up "$2"
		;;
	--help|help)
		usage
		;;
	*)
		wifi_reload "$1"
		;;
esac

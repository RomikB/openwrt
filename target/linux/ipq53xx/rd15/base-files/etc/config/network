config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config device 'eth0_dev'
	option name 'eth0'

config device 'port4_dev'
	option name 'port4'
	option ipv6 '1'
	option gro '0'

config device 'br_lan_dev'
	option name 'br-lan'
	option type 'bridge'
	list ports 'port2'
	list ports 'port3'
	list ports 'port4'
	option force_link '1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '64'

config interface 'wan'
	option device 'port1'
	option proto 'dhcp'
	option ipv6 '1'
	option wantype 'eth'
	option metric '10'

config interface 'wan6'
	option device 'port1'
	option proto 'dhcpv6'

config alias 'lan_ipv6_alias'
	option interface 'lan'
	option proto 'static'
	option ip6addr 'fd00:6969:6969::1'

config device 'br_guest_dev'
	option name 'br-guest'
	option type 'bridge'
	option bridge_empty '1'

config interface 'guest'
	option device 'br-guest'
	option proto 'static'
	option ipaddr '192.168.2.1'
	option netmask '255.255.255.0'

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config device 'eth0_dev'
	option name 'eth0'

config device 'eth1_dev'
	option name 'eth1'
	option ipv6 '1'

config switch 'switch0'
	option name 'switch0'

config switch 'switch1'
	option name 'switch1'
	option enable_vlan '1'

config switch_vlan 'vlan1'
	option device 'switch1'
	option vlan '1'
	option vid '1'
	option ports '3 5t'

config switch_vlan 'vlan2'
	option device 'switch1'
	option vlan '2'
	option vid '2'
	option ports '2 5t'

config switch_vlan 'vlan3'
	option device 'switch1'
	option vlan '3'
	option vid '3'
	option ports '1 5t'

config device 'br_lan_dev'
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0.2'
	list ports 'eth0.3'
	list ports 'eth1'
	option force_link '1'

config interface 'eth0'
	option device 'eth0'
	option keepup '1'

config interface 'eth1'
	option device 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '64'

config interface 'wan'
	option device 'eth0.1'
	option proto 'dhcp'
	option ipv6 '1'
	option wantype 'eth'

config interface 'wan6'
	option device 'eth0.1'
	option proto 'dhcpv6'

config alias 'lan_ipv6_alias'
	option interface 'lan'
	option proto 'static'
	option ip6addr 'fd00:6969:6969::1'

config interface 'eth0_1'
	option device 'eth0.1'

config interface 'eth0_2'
	option device 'eth0.2'

config interface 'eth0_3'
	option device 'eth0.3'

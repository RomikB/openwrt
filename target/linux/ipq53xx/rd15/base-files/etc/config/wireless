
config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'phy1'
	option channel '1'
	option band '2g'
	option htmode 'HE40'
	option hwmode '11ax'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt_RD15_2.4G'
	option encryption 'psk2'
	option key '12345678'
	option ifname 'ath0'


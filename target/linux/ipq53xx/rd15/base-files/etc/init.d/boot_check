#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenWrt.org
# Fixate successful boot in NVRAM to prevent U-Boot rollback to backup slot

START=99

boot() {
	command -v nvram >/dev/null 2>&1 || return 0

	local flg=0
	local flag_boot_rootfs="$(nvram get flag_boot_rootfs 2>/dev/null)"
	local flag_boot_success="$(nvram get flag_boot_success 2>/dev/null)"
	local flag_try_sys1_failed="$(nvram get flag_try_sys1_failed 2>/dev/null)"
	local flag_try_sys2_failed="$(nvram get flag_try_sys2_failed 2>/dev/null)"
	local flag_last_success="$(nvram get flag_last_success 2>/dev/null)"

	[ "$flag_boot_success" != "1" ] && {
		flg=1
		nvram set flag_boot_success=1
	}
	[ "$flag_try_sys1_failed" != "0" ] && {
		flg=1
		nvram set flag_try_sys1_failed=0
	}
	[ "$flag_try_sys2_failed" != "0" ] && {
		flg=1
		nvram set flag_try_sys2_failed=0
	}

	[ "$flag_boot_rootfs" = "0" -o "$flag_boot_rootfs" = "1" ] && [ "$flag_boot_rootfs" != "$flag_last_success" ] && {
		flg=1
		nvram set flag_last_success="$flag_boot_rootfs"
	}

	if [ "$flg" = "1" ]; then
		nvram commit
		logger -t boot_check "Boot status fixated in NVRAM for slot $flag_boot_rootfs"
	fi
}

start() {
	boot
}

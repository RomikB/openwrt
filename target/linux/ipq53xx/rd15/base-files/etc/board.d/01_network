#!/bin/sh
# Xiaomi Router BE3600 (RD15) board detection script for OpenWrt

CFG=/etc/board.json

. /lib/functions/uci-defaults.sh

ipq53xx_setup_interfaces()
{
	local board="$1"

	case "$board" in
	qcom,ipq5332-ap-mi04.1-c2 |\
	qcom,ipq5332-rd15 |\
	*ap-mi04.1* | *rd15*)
		# Xiaomi Router BE3600 (RD15) DSA network interfaces (port1-port4)
		ucidef_set_interfaces_lan_wan "port2 port3 port4" "port1"
		;;
	*)
		echo "Unsupported hardware: $board"
		;;
	esac
}

board_config_update
board=$(board_name)
ipq53xx_setup_interfaces "$board"
board_config_flush

exit 0

#!/bin/sh
# ==============================================================================
# Script: 10-apk-core-repo
# Purpose: Point core package repository feed to custom GitHub Pages repository.
# ==============================================================================

DISTFEEDS="/etc/apk/repositories.d/distfeeds.list"

[ -f "$DISTFEEDS" ] || return 0 2>/dev/null || exit 0

# 1. Substitute openwrt_core URL with custom GitHub Pages repository
sed -i 's|https://downloads.openwrt.org/releases/25.12-SNAPSHOT/targets/ipq53xx/[^/]*/packages|https://romikb.github.io/releases/25.12-SNAPSHOT/targets/ipq53xx/ipq53xx_32/packages|g' "$DISTFEEDS"

return 0 2>/dev/null || exit 0

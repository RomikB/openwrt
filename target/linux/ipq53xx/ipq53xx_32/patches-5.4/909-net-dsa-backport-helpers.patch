+static inline struct net_device *dsa_port_to_master(const struct dsa_port *dp)
+{
+	if (!dp || !dp->cpu_dp)
+		return NULL;
+	return dp->cpu_dp->master;
+}
+
+static inline struct net_device *dsa_slave_to_master(const struct net_device *dev)
+{
+	struct dsa_port *dp;
+
+	if (!dev || !dsa_slave_dev_check(dev))
+		return NULL;
+
+	dp = dsa_port_from_netdev((struct net_device *)dev);
+	if (IS_ERR_OR_NULL(dp))
+		return NULL;
+
+	return dsa_port_to_master(dp);
+}
+
+#define DSA_YT921X_VID_BASE	4000
+
+static inline u16 dsa_slave_to_vid(const struct net_device *dev)
+{
+	struct dsa_port *dp;
+
+	if (!dev || !dsa_slave_dev_check(dev))
+		return 0;
+
+	dp = dsa_port_from_netdev((struct net_device *)dev);
+	if (IS_ERR_OR_NULL(dp))
+		return 0;
+
+	return (dp->index == 0) ? (DSA_YT921X_VID_BASE + 4) : (u16)(DSA_YT921X_VID_BASE + dp->index);
+}
